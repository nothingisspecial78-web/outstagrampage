{
  "name": "Outstagram — Post less. Go somewhere. Meet someone.",
  "short_name": "Outstagram",
  "description": "Outstagram is the calm web app designed to replace infinite scrolling with real-world moments.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#FAF7F2",
  "theme_color": "#C85A32",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["social", "lifestyle", "travel"],
  "icons": [
    {
      "src": "/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily Quest",
      "short_name": "Quest",
      "url": "/quest",
      "icons": [{ "src": "/logo.svg", "sizes": "any" }]
    },
    {
      "name": "Capture Moment",
      "short_name": "Capture",
      "url": "/capture",
      "icons": [{ "src": "/logo.svg", "sizes": "any" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/chats",
      "icons": [{ "src": "/logo.svg", "sizes": "any" }]
    },
    {
      "name": "Finite Rack",
      "short_name": "Rack",
      "url": "/rack",
      "icons": [{ "src": "/logo.svg", "sizes": "any" }]
    }
  ]
}
